# MineStrator 自动保活环境变量配置模板
MINESTRATOR_EMAIL=your_email@example.com
MINESTRATOR_PASSWORD=your_minestrator_password_here
MINESTRATOR_SERVER_ID=123456
MINESTRATOR_AUTH=Bearer your_auth_token_here

# Telegram 通知配置（可选）
TG_BOT_TOKEN=your_telegram_bot_token_here
TG_CHAT_ID=your_telegram_chat_id_here

# 代理节点配置（可选，填入 VMess / VLESS 节点链接）
MINESTRATOR_PROXY_NODES=
PROXY_NODES=

